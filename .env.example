PORT=4173
HOST=127.0.0.1
PORLI_DB=./var/porli.sqlite
# Local demonstration only. Never enable on a public host.
PORLI_DEMO=1
# Insert the fictional listings into an empty database. Defaults to the PORLI_DEMO value.
PORLI_SEED=1
# Optional. Creates (or restores) an administrator account at startup on hosts without demo accounts.
# On Cloudflare set both as Worker secrets, never as plain variables.
PORLI_ADMIN_EMAIL=
PORLI_ADMIN_PASSWORD=
# Optional. A Google Maps Embed API browser key, restricted by HTTP referrer to this site's
# domains. Without it, listing pages fall back to the keyless Google Maps embed URL.
PORLI_MAPS_EMBED_KEY=
