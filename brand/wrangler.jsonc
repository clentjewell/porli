{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  // The brand page as its own static site on Cloudflare (docs/54): assets only, no script,
  // no database. Deploy from this directory with `npx wrangler deploy`.
  "name": "realdistrict-brand",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./public", "html_handling": "auto-trailing-slash", "not_found_handling": "404-page" }
}
